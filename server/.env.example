PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/studymate
JWT_SECRET=super_secret_studymate_development_key_change_in_production_987654321
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
UPLOAD_DIR=uploads

# ==============================================================================
# EMAIL DISPATCH CONFIGURATION
# ==============================================================================

# Option A: Cloud HTTPS API (RECOMMENDED for Render Free Tier - bypasses SMTP port blocking)
# Get a free API key at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="StudyMate <onboarding@resend.dev>"

# Option B: Brevo Cloud HTTPS API (300 free emails/day)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option C: Gmail App Password (SMTP Port 465 / 587 - Best for Local Development or Paid Hosting)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
# EMAIL_FROM="StudyMate <your_email@gmail.com>"
